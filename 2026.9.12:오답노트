===================================================================================================================================<<<<여러 변수들의 공간형성>>>>>
1.print할 변수 결정
2.나머지 변수는 print하는 변수를 support
3.scanf할 변수 결정


#include <stdio.h>

int main(){
    int year,period;
    float amount,value,inrate;         //머리속으로 변수 관계성을 공간화해야함
    year=0;
    scanf("%d %f %f",&period,&amount,&inrate);
    while(year<period){
        printf("%2d%8.2f\n",year,amount);     
        value=amount+amount*inrate;            //amount 가 main이고, value는 amount 에 대입하기 위한 외부 객체임. amount에 scanf도 하고 printf도 하지만 scanf는 while이전 한번만 이뤄지고,printf이전에 amonut을 갱신함으로써 ㄱㅊ음
        year++;
        amount=value;
        
    }
}
